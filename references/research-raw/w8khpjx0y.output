      },
      {
        "name": "NVIDIA FourCastNet3 (SFNO)",
        "what_it_does": "Global probabilistic ensemble weather forecasting using Spherical Fourier Neural Operator attention, Apache 2.0 licensed.",
        "how_we_use_it": "Feature extractor — the AFNO/SFNO attention blocks are architecturally simple and liftable as a reusable spectral-attention encoder. If we build a custom backbone rather than using StormCast, FourCastNet's SFNO blocks are the cleanest open building block for a Fourier-domain terrain-weather encoder.",
        "source": "huggingface.co/nvidia/fourcastnet3",
